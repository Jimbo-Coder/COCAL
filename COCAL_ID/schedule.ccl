# Schedule definitions for thorn COCAL_ID

if (CCTK_Equals(initial_data, "CocalRNS") || CCTK_Equals(initial_data, "CocalBNS") ||
    CCTK_Equals(initial_data, "CocalBHT") || CCTK_Equals(initial_data, "CocalBBH") ||
    CCTK_Equals(initial_data, "CocalBBHT"))
{
   SCHEDULE COCAL_ID_read_data IN HydroBase_Initial BEFORE COCAL_ID_set_data
   {
      LANG: FORTRAN
      OPTIONS: global
   } "Read the COCAL data once per MPI rank"

   SCHEDULE COCAL_ID_set_data IN HydroBase_Initial
   {
      LANG: FORTRAN
   } "Interpolate the COCAL data onto the Cactus grid"

   SCHEDULE COCAL_ID_free_data AT POSTPOSTINITIAL
   {
      LANG: FORTRAN
      OPTIONS: global
   } "Free the COCAL data"
}
