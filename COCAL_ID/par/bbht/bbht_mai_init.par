CarpetIOHDF5::checkpoint  = no

# IOUtil
IOUtil::out_dir                 = ${parfile}
IOUtil::parfile_write           = "no"
IOUtil::checkpoint_on_terminate = no
IOUtil::recover                 = "no"

# TimerReport
TimerReport::out_every    = 32
TimerReport::out_filename = "TimerReport"
