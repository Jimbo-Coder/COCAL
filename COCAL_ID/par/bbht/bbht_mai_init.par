# Multipole
Multipole::nradii       = 1
Multipole::radius[0]    = 27.421649
Multipole::out_every    = 32
Multipole::l_max        = 4
Multipole::ntheta       = 32
Multipole::nphi         = 64
Multipole::output_ascii = yes
Multipole::output_hdf5  = no
Multipole::variables    = "WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='psi4'}"

# NaNChecker
NaNChecker::check_every     = 1
NaNChecker::action_if_found = "abort"
NaNChecker::check_vars      = "
  ADMBase::metric ADMBase::curv ADMBase::lapse ADMBase::shift
  Baikal::evol_variables
  TmunuBase::stress_energy_scalar TmunuBase::stress_energy_vector TmunuBase::stress_energy_tensor
  HydroBase::rho HydroBase::press HydroBase::eps HydroBase::vel HydroBase::w_lorentz
  GRHayLHD::grmhd_conservatives GRHayLHD::failure_checker
"

# CarpetIOBasic
IOBasic::outInfo_every      = 32
IOBasic::outInfo_reductions = "minimum maximum"
IOBasic::outInfo_vars       = "ADMBase::alp"

# CarpetIOScalar
IOScalar::outScalar_every            = 32
IOScalar::one_file_per_group         = yes
IOScalar::all_reductions_in_one_file = yes
IOScalar::outScalar_reductions       = "minimum maximum norm2"
IOScalar::outScalar_vars             = "
  ADMBase::metric ADMBase::curv ADMBase::lapse ADMBase::shift
  Baikal::HGF Baikal::MU0GF Baikal::MU1GF Baikal::MU2GF
  TmunuBase::stress_energy_scalar TmunuBase::stress_energy_vector TmunuBase::stress_energy_tensor
  HydroBase::rho HydroBase::press HydroBase::eps HydroBase::vel HydroBase::w_lorentz
  GRHayLHD::grmhd_conservatives GRHayLHD::failure_checker
"

