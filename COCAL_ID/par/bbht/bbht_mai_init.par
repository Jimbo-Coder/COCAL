# Initialization-only smoke grid; replace the initial-data path.
# This grid does not establish horizon/constraint convergence.
# Carpet + GRHayLHD + Baikal: COCAL BBHT
# Generated by generate_parfile.py; settings: local.


ActiveThorns = "
  Carpet
  COCAL_ID
  Baikal
  CarpetIOASCII
  CarpetIOBasic
  CarpetIOScalar
  CarpetIOHDF5
  AHFinderDirect
  QuasiLocalMeasures
  VolumeIntegrals_vacuum
  NaNChecker
  TimerReport
  TerminationTrigger
  Multipole
  GRHayLHD
  VolumeIntegrals_GRMHD
  CarpetLib
  CarpetRegrid2
  CartGrid3D
  CoordBase
  CoordGauge
  Time
  SymBase
  LoopControl
  CycleClock
  Timers
  ADMBase
  HydroBase
  StaticConformal
  InitBase
  ADMCoupling
  ADMMacros
  Boundary
  MoL
  NewRad
  TmunuBase
  Vectors
  SummationByParts
  IOUtil
  CarpetSlab
  CarpetReduce
  SphericalSurface
  CarpetInterp
  SpaceMask
  TGRtensor
  WeylScal4
  GRHayLib
  Slab
  LocalReduce
  AEILocalInterp
  GenericFD
"

# Resolution and output cadence


# Cactus
Cactus::terminate       = "either"
Cactus::cctk_itlast     = 0
Cactus::cctk_final_time = 1000

# TerminationTrigger
TerminationTrigger::max_walltime          = 1
TerminationTrigger::on_remaining_walltime = 5

# CartGrid3D
CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = no

# Carpet
Carpet::domain_from_coordbase    = yes
Carpet::ghost_size               = 3
Carpet::max_refinement_levels    = 6
Carpet::refinement_centering     = "vertex"
Carpet::use_buffer_zones         = yes
Carpet::prolongation_order_space = 5
Carpet::prolongation_order_time  = 2
Carpet::init_fill_timelevels     = yes
Carpet::poison_new_timelevels    = yes
Carpet::check_for_poison         = no

# CarpetLib
CarpetLib::poison_new_memory = yes
CarpetLib::poison_value      = 114

# CarpetInterp
CarpetInterp::tree_search       = yes
CarpetInterp::check_tree_search = no

# LoopControl
LoopControl::random_jump_probability = 0

# CoordBase
CoordBase::xmin                  = -48
CoordBase::xmax                  = 48
CoordBase::dx                    = 1.6
CoordBase::boundary_size_x_lower = 3
CoordBase::boundary_size_x_upper = 3
CoordBase::ymin                  = -48
CoordBase::ymax                  = 48
CoordBase::dy                    = 1.6
CoordBase::boundary_size_y_lower = 3
CoordBase::boundary_size_y_upper = 3
CoordBase::zmin                  = -48
CoordBase::zmax                  = 48
CoordBase::dz                    = 1.6
CoordBase::boundary_size_z_lower = 3
CoordBase::boundary_size_z_upper = 3

# CarpetRegrid2
CarpetRegrid2::regrid_every                   = 0
CarpetRegrid2::num_centres                    = 3
CarpetRegrid2::ensure_proper_nesting          = yes
CarpetRegrid2::min_distance                   = 4
CarpetRegrid2::freeze_unaligned_levels        = yes
CarpetRegrid2::freeze_unaligned_parent_levels = yes

CarpetRegrid2::num_levels_1                   = 6
CarpetRegrid2::position_x_1                   = -1.249999999999994
CarpetRegrid2::radius_1[1]                    = 11.2
CarpetRegrid2::radius_1[2]                    = 5.600000000000001
CarpetRegrid2::radius_1[3]                    = 2.8
CarpetRegrid2::radius_1[4]                    = 1.4
CarpetRegrid2::radius_1[5]                    = 0.7000000000000001

CarpetRegrid2::num_levels_2                   = 6
CarpetRegrid2::position_x_2                   = 1.250000000000001
CarpetRegrid2::radius_2[1]                    = 11.2
CarpetRegrid2::radius_2[2]                    = 5.600000000000001
CarpetRegrid2::radius_2[3]                    = 2.8
CarpetRegrid2::radius_2[4]                    = 1.4
CarpetRegrid2::radius_2[5]                    = 0.7000000000000001

CarpetRegrid2::num_levels_3                   = 2
CarpetRegrid2::radius_3[1]                    = 25.6

# Time
Time::dtfac           = 0.1
Time::timestep_method = "courant_static"

# MoL
MoL::ODE_Method             = "rk4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

# InitBase
InitBase::initial_data_setup_method = "init_all_levels"

# COCAL_ID
COCAL_ID::COCAL_ID_PathToID        = "/path/to/work_area_BBHT_ra0.1"
COCAL_ID::COCAL_ID_bbh_fill_method = "smooth"
COCAL_ID::COCAL_ID_verbose         = no

# ADMBase
ADMBase::metric_type              = "physical"
ADMBase::initial_data             = "CocalBBHT"
ADMBase::initial_lapse            = "Cocal"
ADMBase::initial_shift            = "Cocal"
ADMBase::initial_dtlapse          = "zero"
ADMBase::initial_dtshift          = "zero"
ADMBase::metric_timelevels        = 3
ADMBase::lapse_timelevels         = 3
ADMBase::shift_timelevels         = 3
ADMBase::evolution_method         = "Baikal"
ADMBase::lapse_evolution_method   = "Baikal"
ADMBase::shift_evolution_method   = "Baikal"
ADMBase::dtlapse_evolution_method = "Baikal"
ADMBase::dtshift_evolution_method = "Baikal"

# HydroBase
HydroBase::initial_hydro = "Cocal"
HydroBase::timelevels    = 3
HydroBase::initial_Bvec  = "zero"
HydroBase::initial_Avec  = "zero"
HydroBase::initial_Aphi  = "zero"

# GRHayLHD
GRHayLHD::Symmetry                   = "none"
GRHayLHD::Convert_to_HydroBase_every = 32

# GRHayLib
GRHayLib::EOS_type                    = "Hybrid"
GRHayLib::neos                        = 1
GRHayLib::gamma_th                    = 1.33333
GRHayLib::k_ppoly0                    = 0.1703630368949246
GRHayLib::gamma_ppoly_in              = [1.33333]
GRHayLib::rho_ppoly_in                = [0]
GRHayLib::evolve_temperature          = no
GRHayLib::con2prim_routine            = "Palenzuela1D"
GRHayLib::con2prim_backup_routines[0] = "Newman1D"
GRHayLib::rho_b_atm                   = 1e-12
GRHayLib::rho_b_min                   = 1e-12
GRHayLib::rho_b_max                   = 0.02
GRHayLib::Psi6threshold               = 60
GRHayLib::calc_primitive_guess        = yes

# VolumeIntegrals_GRMHD
VolumeIntegrals_GRMHD::NumIntegrals                    = 1
VolumeIntegrals_GRMHD::VolIntegral_out_every           = 32
VolumeIntegrals_GRMHD::enable_file_output              = 1
VolumeIntegrals_GRMHD::verbose                         = 0
VolumeIntegrals_GRMHD::Integration_quantity_keyword[1] = "restmass"

# ADMMacros
ADMMacros::spatial_order = 4

# SpaceMask
SpaceMask::use_mask = yes

# Baikal
Baikal::FD_order      = 4
Baikal::diss_strength = 0.2
Baikal::eta           = 1.84008064091138

# TmunuBase
TmunuBase::stress_energy_storage = yes
TmunuBase::stress_energy_at_RHS  = yes
TmunuBase::prolongation_type     = "none"
TmunuBase::timelevels            = 3

