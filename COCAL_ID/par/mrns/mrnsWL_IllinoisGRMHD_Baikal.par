# Carpet + IllinoisGRMHD + Baikal: magnetized waveless RNS
# Semiproduction grid; make temporary reduced copies for local smoke tests.

$itlast=100000000
$out_every=128
$out_every2d=512

# Active thorns
ActiveThorns = "
  ADMBase
  ADMCoupling
  ADMMacros
  AEILocalInterp
  Baikal
  Boundary
  Carpet
  CarpetInterp
  CarpetIOASCII
  CarpetIOBasic
  CarpetIOHDF5
  CarpetIOScalar
  CarpetLib
  CarpetReduce
  CarpetRegrid2
  CarpetSlab
  CartGrid3D
  CoordBase
  CoordGauge
  COCAL_ID
  CycleClock
  EOS_Omni
  HydroBase
  InitBase
  IOUtil
  LocalReduce
  LoopControl
  MoL
  Multipole
  NewRad
  NaNChecker
  QuasiLocalMeasures
  Slab
  smallbPoynET
  SpaceMask
  SphericalSurface
  StaticConformal
  SummationByParts
  SymBase
  SystemTopology
  SystemStatistics
  TerminationTrigger
  TGRtensor
  Time
  Timers
  TimerReport
  TmunuBase
  Trigger
  Vectors
  WeylScal4
  VolumeIntegrals_GRMHD
  VolumeIntegrals_vacuum

  IllinoisGRMHD
  GRHayLib

"

# Runtime and termination
Cactus::terminate           = "time"
Cactus::cctk_itlast          = $itlast
Cactus::cctk_final_time     = 600.0

TerminationTrigger::max_walltime = @WALLTIME_HOURS@
TerminationTrigger::on_remaining_walltime = 45  # minutes
TerminationTrigger::check_file_every = 512
TerminationTrigger::termination_file = "TerminationTrigger.txt"
TerminationTrigger::termination_from_file   = "yes"
TerminationTrigger::create_termination_file = "yes"

# Timing
TimerReport::out_every    = $out_every
TimerReport::out_filename = "TimerReport"
TimerReport::output_all_timers          = "yes"
TimerReport::output_all_timers_together = "yes"
TimerReport::output_all_timers_readable = "yes"
TimerReport::n_top_timers               = 40

# Grid and AMR
Carpet::domain_from_coordbase = "yes"
CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CarpetInterp::check_tree_search = "no"
CarpetInterp::tree_search       = "yes"

CoordBase::xmax = 384.0 # to300 riemann isolated-star domain
CoordBase::ymax = CoordBase::xmax
CoordBase::zmax = CoordBase::xmax
CoordBase::xmin = -CoordBase::xmax
CoordBase::ymin = -CoordBase::xmax
CoordBase::zmin = -CoordBase::xmax
CoordBase::dx   =  0.125*(2**6) # exponent is number of ref levels -1, gives that value at the most refined level.
CoordBase::dy   =  CoordBase::dx
CoordBase::dz   = CoordBase::dx

CarpetRegrid2::regrid_every =   0
CarpetRegrid2::num_centres  =   1
CarpetRegrid2::num_levels_1 = 7
CarpetRegrid2::radius_1[1]  = 192.0
CarpetRegrid2::radius_1[2]  = 96.0
CarpetRegrid2::radius_1[3]  = 48.0
CarpetRegrid2::radius_1[4]  = 24.0
CarpetRegrid2::radius_1[5]  = 16.0
CarpetRegrid2::radius_1[6]  = 11.0

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 1
CoordBase::boundary_shiftout_y_lower    = 1
CoordBase::boundary_shiftout_z_lower    = 1
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0

# Storage and coupling
TmunuBase::stress_energy_storage = yes
TmunuBase::stress_energy_at_RHS  = yes
TmunuBase::timelevels            =  3
TmunuBase::prolongation_type     = none

HydroBase::timelevels            = 3

ADMMacros::spatial_order = 4

ADMBase::metric_type     = "physical"
SpaceMask::use_mask      = "yes"

Carpet::enable_all_storage       = no
Carpet::use_buffer_zones         = "yes"

Carpet::poison_new_timelevels    = "yes"
Carpet::check_for_poison         = "no"

Carpet::init_3_timelevels        = no
Carpet::init_fill_timelevels     = "yes"

CarpetLib::poison_new_memory = "yes"
CarpetLib::poison_value      = 114
CarpetLib::support_staggered_operators = "yes"

Carpet::output_timers_every = $out_every

Carpet::max_refinement_levels    = 10
driver::ghost_size               = 3
Carpet::prolongation_order_space = 5
Carpet::prolongation_order_time  = 2

time::dtfac = 0.4
time::timestep_method = "courant_static"

MoL::ODE_Method             = "rk4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

Multipole::out_dir			 = "./data/Multipole"
Multipole::l_max                         = 4
Multipole::nphi                          = 240
Multipole::nradii                        = 4
Multipole::ntheta                        = 120
Multipole::out_every                     = $out_every
Multipole::output_ascii                  = yes
Multipole::output_hdf5                   = yes
Multipole::radius[0]                     = 0.6*CoordBase::xmax
Multipole::radius[1]                     = 0.7*CoordBase::xmax
Multipole::radius[2]                     = 0.8*CoordBase::xmax
Multipole::radius[3]                     = 0.9*CoordBase::xmax

Multipole::variables                     = "WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='psi4'}"

NaNChecker::check_every = 256
NaNChecker::action_if_found = "terminate"
NaNChecker::check_vars = "ADMBase::metric ADMBase::lapse ADMBase::shift HydroBase::rho HydroBase::eps HydroBase::press HydroBase::vel HydroBase::Bvec"

# Evolution
ADMBase::evolution_method        = "Baikal"
ADMBase::lapse_evolution_method  = "Baikal"
ADMBase::shift_evolution_method  = "Baikal"
ADMBase::dtlapse_evolution_method= "Baikal"
ADMBase::dtshift_evolution_method= "Baikal"

Baikal::diss_strength = 0.2
Baikal::eta           = 1.0/1.357181361057354    # M_ADM from selected MRNS sequence

# Initial data
InitBase::initial_data_setup_method = "init_some_levels"

COCAL_ID::COCAL_ID_PathToID = "/anvil/projects/x-mca99s008/coc2cac_IDs/mrns/work_area_RNS_Mpa0.9_LCp1.7_LCf0.00_M1.25_SE3_df112"
COCAL_ID::COCAL_ID_read_magnetic_potential = "True"
COCAL_ID::COCAL_ID_offset_AvecAphi = "True"
COCAL_ID::COCAL_ID_verbose = "True"

COCAL_ID::COCAL_ID_rnstype = "MRNS_WL"

ADMBase::initial_data            = "CocalRNS"
ADMBase::initial_lapse           = "Cocal"
ADMBase::initial_shift           = "Cocal"
HydroBase::initial_hydro         = "Cocal"
HydroBase::initial_Y_e         = "none"
HydroBase::initial_temperature = "none"
HydroBase::initial_entropy     = "none"
HydroBase::initial_Avec        = "Cocal"
HydroBase::initial_Aphi        = "Cocal"
HydroBase::initial_Bvec          = "zero"
ADMBase::initial_dtlapse         = "zero"
ADMBase::initial_dtshift         = "zero"

ADMBase::metric_timelevels        = 3
ADMBase::lapse_timelevels         = 3
ADMBase::shift_timelevels         = 3

IllinoisGRMHD::Symmetry = "none"
IllinoisGRMHD::Sym_Bz = 1.0
IllinoisGRMHD::Convert_to_HydroBase_every = $out_every

# Diagnostics
SphericalSurface::nsurfaces = 4
SphericalSurface::maxntheta = 39
SphericalSurface::maxnphi = 76

SphericalSurface::ntheta      [0] = 39
SphericalSurface::nphi        [0] = 76
SphericalSurface::nghoststheta[0] = 2
SphericalSurface::nghostsphi  [0] = 2
SphericalSurface::set_spherical[0] = yes
SphericalSurface::name        [0] = "0.6"
SphericalSurface::origin_x     [0] = 0.0
SphericalSurface::radius      [0] = 0.6*CoordBase::xmax

SphericalSurface::ntheta      [1] = 39
SphericalSurface::nphi        [1] = 76
SphericalSurface::nghoststheta[1] = 2
SphericalSurface::nghostsphi  [1] = 2
SphericalSurface::set_spherical[1] = yes
SphericalSurface::name        [1] = "0.7"
SphericalSurface::origin_x     [1] = 0.0
SphericalSurface::radius      [1] = 0.7*CoordBase::xmax

SphericalSurface::ntheta      [2] = 39
SphericalSurface::nphi        [2] = 76
SphericalSurface::nghoststheta[2] = 2
SphericalSurface::nghostsphi  [2] = 2
SphericalSurface::set_spherical[2] = yes
SphericalSurface::radius      [2] = 0.8*CoordBase::xmax
SphericalSurface::name        [2] = "0.8"

SphericalSurface::ntheta      [3] = 39
SphericalSurface::nphi        [3] = 76
SphericalSurface::nghoststheta[3] = 2
SphericalSurface::nghostsphi  [3] = 2
SphericalSurface::set_spherical[3] = yes
SphericalSurface::radius      [3] = 0.9*CoordBase::xmax
SphericalSurface::name        [3] = "0.9"

QuasiLocalMeasures::num_surfaces   = 4
QuasiLocalMeasures::spatial_order  = 4
QuasiLocalMeasures::interpolator = "Lagrange polynomial interpolation"
QuasiLocalMeasures::interpolator_options = "order=4"

QuasiLocalMeasures::surface_name[0] = "0.6"
QuasiLocalMeasures::surface_index[0] = 0

QuasiLocalMeasures::surface_name[1] = "0.7"
QuasiLocalMeasures::surface_index[1] = 1

QuasiLocalMeasures::surface_name[2] = "0.8"
QuasiLocalMeasures::surface_index[2] = 2

QuasiLocalMeasures::surface_name[3] = "0.9"
QuasiLocalMeasures::surface_index[3] = 3

VolumeIntegrals_GRMHD::NumIntegrals = 2
VolumeIntegrals_GRMHD::VolIntegral_out_every = $out_every
VolumeIntegrals_GRMHD::enable_file_output = 1
VolumeIntegrals_GRMHD::outVolIntegral_dir = "./volume_integration"
VolumeIntegrals_GRMHD::verbose = 1

VolumeIntegrals_GRMHD::Integration_quantity_keyword[1] = "centerofmass"

VolumeIntegrals_GRMHD::Integration_quantity_keyword[2] = "restmass"

VolumeIntegrals_GRMHD::volintegral_inside_sphere__radius            [1] =  7.0

VolumeIntegrals_vacuum::HamiltonianVarString                   = "Baikal::HGF"
VolumeIntegrals_vacuum::Momentum0VarString                     = "Baikal::MU0GF"
VolumeIntegrals_vacuum::Momentum1VarString                     = "Baikal::MU1GF"
VolumeIntegrals_vacuum::Momentum2VarString                     = "Baikal::MU2GF"
VolumeIntegrals_vacuum::NumIntegrals                           = 3
VolumeIntegrals_vacuum::VolIntegral_out_every                  = $out_every
VolumeIntegrals_vacuum::enable_file_output                     = 1
VolumeIntegrals_vacuum::outVolIntegral_dir                     = "./volume_integration"
VolumeIntegrals_vacuum::verbose                                = 1

VolumeIntegrals_vacuum::Integration_quantity_keyword[1]       = "ADM_Mass"
VolumeIntegrals_vacuum::Integration_quantity_keyword[2]       = "ADM_Angular_Momentum"
VolumeIntegrals_vacuum::Integration_quantity_keyword[3]        = "H_M_CnstraintsL2"

# Output and recovery
IO::out_dir             = ${parfile}

IO::out_mode            = "onefile"

IOBasic::outInfo_every = $out_every
IOBasic::outInfo_vars  = "Carpet::physical_time_per_hour HydroBase::rho{reductions='maximum'} Baikal::HGF{reductions='maximum'}"

# Equation of state and primitive recovery
GRHayLib::EOS_type                    = "Hybrid"

GRHayLib::neos                        = 1
GRHayLib::gamma_th                    = 2.0
GRHayLib::k_ppoly0                    = 7.09713E+01
GRHayLib::gamma_ppoly_in              = [2.0]

GRHayLib::evolve_temperature          = no
GRHayLib::con2prim_routine            = "Palenzuela1D"
GRHayLib::con2prim_backup_routines[0] = "Font1D"
GRHayLib::rho_b_atm                   = 1e-12
GRHayLib::rho_b_min                   = 1e-12
GRHayLib::rho_b_max                   = 0.004
GRHayLib::Y_e_atm                     = 0.5
GRHayLib::Y_e_max                     = 0.5
GRHayLib::T_atm                       = 1e-2
GRHayLib::T_min                       = 1e-2
GRHayLib::T_max                       = 90
GRHayLib::Psi6threshold               = 60
GRHayLib::Lorenz_damping_factor       = 0.1
GRHayLib::calc_primitive_guess        = yes

IOScalar::outScalar_every    = $out_every
IOScalar::one_file_per_group = "yes"
IOScalar::all_reductions_in_one_file = "yes"
IOScalar::outScalar_reductions = "norm1 norm2 norm_inf sum maximum minimum"
IOScalar::outScalar_vars     = "
 HydroBase::rho
 HydroBase::press
 HydroBase::vel
 HydroBase::Bvec
 HydroBase::Avec
 HydroBase::Aphi
 ADMBase::lapse
 ADMBase::shift
 Baikal::HGF{reductions='norm1 norm2 maximum minimum norm_inf sum_abs_squared'}
 Baikal::MU0GF{reductions='norm1 norm2 maximum minimum norm_inf sum_abs_squared'}
 Carpet::timing{reductions='average'}
"
CarpetIOHDF5::checkpoint                  = yes
IOUtil::checkpoint_dir                  = "checkpoints"
IOUtil::checkpoint_ID                   = no
IOUtil::checkpoint_every                = -1
IOUtil::checkpoint_every_walltime_hours = -1
IOUtil::checkpoint_on_terminate         = yes
IOUtil::checkpoint_keep                 = 1
IOUtil::recover     = "autoprobe"
IOUtil::recover_dir = "checkpoints"

CarpetIOASCII::out0D_every     = $out_every
CarpetIOASCII::out0D_vars      = "
 Carpet::timing
 QuasiLocalMeasures::qlm_scalars
 QuasiLocalMeasures::qlm_multipole_moments
 QuasiLocalMeasures::qlm_grid_real
 SphericalSurface::sf_active

 SphericalSurface::sf_valid
 SphericalSurface::sf_info
 SphericalSurface::sf_radius
 SphericalSurface::sf_origin
 SphericalSurface::sf_coordinate_descriptors
"

CarpetIOASCII::out1D_every        = $out_every*4
CarpetIOASCII::one_file_per_group = yes
CarpetIOASCII::output_symmetry_points = no
CarpetIOASCII::out1D_vars         = "
 HydroBase::rho
 HydroBase::vel
 HydroBase::press
 HydroBase::eps
 HydroBase::Bvec
 HydroBase::Avec
 HydroBase::Aphi
 ADMBase::lapse
 ADMBase::metric
 ADMBase::curv
 Baikal::HGF
 Baikal::MU0GF
"

CarpetIOHDF5::out2D_every = $out_every2d
CarpetIOHDF5::out2D_vars = "
 HydroBase::rho
 HydroBase::vel
 HydroBase::press
 HydroBase::eps
 HydroBase::Bvec
 HydroBase::Avec
 HydroBase::Aphi
 ADMBase::lapse
 ADMBase::shift
 ADMBase::metric
 Baikal::HGF
 Baikal::MU0GF
 "

SystemTopology::set_thread_bindings = "no"
